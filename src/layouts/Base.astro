---
import Newsletter from '../components/Newsletter.astro';
import IconHome from '../components/icons/IconHome.astro';
import IconProgramma from '../components/icons/IconProgramma.astro';
import IconGusto from '../components/icons/IconGusto.astro';
import IconMappa from '../components/icons/IconMappa.astro';
import IconNews from '../components/icons/IconNews.astro';
const { title = 'La Perla dei Sibillini', description = 'Visso e i Monti Sibillini: eventi, iniziative e sapori del territorio.', active = '' } = Astro.props;

// URL canonico e immagine OG assoluta, basati su `site` (astro.config.mjs)
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/hero.png', Astro.site);
---
<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#5A1F1B" />

  <!-- Google Consent Mode v2 — default: DENIED (GDPR). Deve stare PRIMA di CookieYes e GA. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
      wait_for_update: 2000
    });
    gtag('set', 'ads_data_redaction', true);
    gtag('set', 'url_passthrough', true);
  </script>

  <!-- CookieYes — banner consensi. Con "Support GCM" attivo aggiorna da solo il Consent Mode. -->
  <script is:inline id="cookieyes" type="text/javascript"
          src="https://cdn-cookieyes.com/client_data/07c3e759432a2a0a7e29928bf9ddd2f5/script.js"></script>

  <!-- Google Analytics 4 -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-S1JKP1BZF4"></script>
  <script is:inline>
    gtag('js', new Date());
    gtag('config', 'G-S1JKP1BZF4');
  </script>

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="stylesheet" href="/css/fonts.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <header class="topbar">
    <div class="lang-switch">
      <span class="active" onclick="setLang('it')">IT</span>
      <span onclick="setLang('en')">EN</span>
    </div>
    <div class="logo-block">
      <img src="/images/logo-visso.png" alt="Comune di Visso" class="logo-crest" />
      <span class="logo-text serif">La perla dei Sibillini</span>
    </div>
  </header>

  <div class="install-banner" id="installBanner">
    <div class="install-icon">⬇</div>
    <div class="install-text">
      <strong data-it="Visso sempre in tasca" data-en="Visso always with you">Visso sempre in tasca</strong>
      <span data-it="Salva l'app sulla Home" data-en="Save the app to your Home">Salva l'app sulla Home</span>
    </div>
    <button onclick="installApp()" data-it="Installa" data-en="Install">Installa</button>
  </div>

  <slot />

  <!-- Attiva notifiche push (discreto) -->
  <div class="push-optin" id="pushOptin" hidden>
    <button id="pushBtn" type="button">🔔 <span data-it="Attiva le notifiche" data-en="Enable notifications">Attiva le notifiche</span></button>
    <span class="push-msg" id="pushMsg"></span>
  </div>
  <style>
    .push-optin{display:flex;justify-content:center;align-items:center;gap:10px;flex-wrap:wrap;margin:26px auto 0;padding:0 16px}
    .push-optin button{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1.5px solid #E4D9CE;color:#5A1F1B;font:inherit;font-weight:700;font-size:14px;padding:10px 18px;border-radius:99px;cursor:pointer}
    .push-optin button:hover{border-color:#5A1F1B}
    .push-optin button.on{background:#EAF3EC;border-color:#8FBF9E;color:#2f7d47;cursor:default}
    .push-msg{font-size:13px;color:#8a7d6f}
  </style>
  <script is:inline>
    (function(){
      var VAPID='BILnaOJSbzJPCBwg0jOgQAHPtB5c_LmV8TtKKjkcbDHQWh4I7D9SgeGxcLTsxEdQcRIyNslIHih_RvuiXNObIVY';
      var SUBSCRIBE='https://studio.anigami.eu/api/subscribe';
      var SITE='la-perla-dei-sibillini';
      var bar=document.getElementById('pushOptin'), btn=document.getElementById('pushBtn'), msg=document.getElementById('pushMsg');
      if(!bar || !('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) return;
      bar.hidden=false;
      try{ navigator.serviceWorker.register('/sw.js'); }catch(e){}
      function lang(){ var a=document.querySelector('.lang-switch .active'); return (a && /en/i.test(a.textContent))?'en':'it'; }
      function label(t){ btn.querySelector('span').textContent=t; }
      function setActive(){ btn.classList.add('on'); label(lang()==='en'?'Notifications on ✓':'Notifiche attive ✓'); }
      function u8(b){ var pad='='.repeat((4-b.length%4)%4), s=(b+pad).replace(/-/g,'+').replace(/_/g,'/'), raw=atob(s), a=new Uint8Array(raw.length); for(var i=0;i<raw.length;i++)a[i]=raw.charCodeAt(i); return a; }
      navigator.serviceWorker.ready.then(function(reg){ return reg.pushManager.getSubscription(); }).then(function(s){ if(s) setActive(); }).catch(function(){});
      btn.addEventListener('click', function(){
        if(btn.classList.contains('on')) return;
        msg.textContent='';
        if(Notification.permission==='denied'){ msg.textContent=lang()==='en'?'Blocked in browser settings':'Bloccate nelle impostazioni del browser'; return; }
        Notification.requestPermission().then(function(perm){
          if(perm!=='granted'){ msg.textContent=lang()==='en'?'Permission not granted':'Permesso non concesso'; return; }
          navigator.serviceWorker.ready
            .then(function(reg){ return reg.pushManager.subscribe({ userVisibleOnly:true, applicationServerKey:u8(VAPID) }); })
            .then(function(sub){ var j=sub.toJSON(); return fetch(SUBSCRIBE,{ method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ subscription:{ endpoint:j.endpoint, keys:j.keys }, site:SITE, lang:lang() }) }); })
            .then(function(r){ if(!r.ok) throw new Error('server'); setActive(); })
            .catch(function(){ msg.textContent=lang()==='en'?'Something went wrong, try again':'Qualcosa è andato storto, riprova'; });
        });
      });
    })();
  </script>

  <Newsletter />

  <div class="mobile-footer">
    <a href="#" onclick="openNewsletter();return false" data-it="Newsletter" data-en="Newsletter">Newsletter</a>
    <span aria-hidden="true"> · </span>
    <a href="https://tipicita.it/privacy.php" target="_blank" rel="noopener" data-it="Privacy Policy" data-en="Privacy Policy">Privacy Policy</a>
  </div>

  <nav class="bottom-nav">
    <a href="/" class={"nav-item" + (active === 'home' ? ' active' : '')}>
      <span class="nav-icon"><IconHome /></span>
      <span data-it="Home" data-en="Home">Home</span>
    </a>
    <a href="/programma" class={"nav-item" + (active === 'programma' ? ' active' : '')}>
      <span class="nav-icon"><IconProgramma /></span>
      <span data-it="Programma" data-en="Schedule">Programma</span>
    </a>
    <a href="/gusto" class={"nav-item" + (active === 'gusto' ? ' active' : '')}>
      <span class="nav-icon"><IconGusto /></span>
      <span data-it="Gusto" data-en="Food">Gusto</span>
    </a>
    <a href="/mappa" class={"nav-item" + (active === 'mappa' ? ' active' : '')}>
      <span class="nav-icon"><IconMappa /></span>
      <span data-it="Mappa" data-en="Map">Mappa</span>
    </a>
    <a href="/news" class={"nav-item" + (active === 'news' ? ' active' : '')}>
      <span class="nav-icon"><IconNews /></span>
      <span data-it="News" data-en="News">News</span>
    </a>
  </nav>

  <button class="contact-fab" onclick="contactWhatsApp()" aria-label="Contattaci su WhatsApp">
    💬 <span data-it="Contattaci" data-en="Contact us">Contattaci</span>
  </button>

  <script src="/js/app.js" is:inline></script>
</body>
</html>
