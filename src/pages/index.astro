---
import Base from '../layouts/Base.astro';
import { getEdition, getProgramme, getCircuits, getArticles, getPlaces, assetImg } from '../lib/directus.js';

// LA TAVOLOZZA — intro editoriale della sezione gusto (contenuto stabile nel codice).
const TAVOLOZZA_BOOKING_URL = 'https://tipicita.it/dettaglio_attivita.php?idAttivita=959';
const TAVOLOZZA = [
  {
    img: '/images/legumi.jpg',
    tag_it: 'La terra', tag_en: 'The land',
    title_it: 'Legumi', title_en: 'Legumes',
    text_it: 'I gioielli dei Sibillini: lenticchie, roveja e cicerchia, piccoli tesori della cucina di montagna.',
    text_en: 'The jewels of the Sibillini: lentils, roveja and cicerchia, small treasures of mountain cuisine.',
  },
  {
    img: '/images/miele.jpg',
    tag_it: 'I fiori', tag_en: 'The flowers',
    title_it: 'Miele', title_en: 'Honey',
    text_it: 'La dolcezza naturale dei pascoli e dei boschi, racchiusa nei profumi dei Sibillini.',
    text_en: 'The natural sweetness of pastures and woods, held in the scents of the Sibillini.',
  },
  {
    img: '/images/tartufo.jpg',
    tag_it: 'Il bosco', tag_en: 'The woods',
    title_it: 'Tartufo', title_en: 'Truffle',
    text_it: "Il profumo prezioso e nascosto dell'Appennino, capace di accendere ogni sapore.",
    text_en: 'The precious, hidden scent of the Apennines, able to bring every flavour to life.',
  },
  {
    img: '/images/trota.jpg',
    tag_it: "L'acqua", tag_en: 'The water',
    title_it: 'Trota', title_en: 'Trout',
    text_it: 'La freschezza viva di sorgenti e torrenti, anima limpida della montagna vissana.',
    text_en: 'The living freshness of springs and streams, the clear soul of the Visso mountains.',
  },
  {
    img: '/images/salumi.jpg',
    tag_it: 'La norcineria', tag_en: 'The norcineria',
    title_it: 'Salumi', title_en: 'Cured meats',
    text_it: 'Saperi antichi, stagionature lente e sapori decisi della tradizione appenninica.',
    text_en: 'Ancient know-how, slow ageing and bold flavours of the Apennine tradition.',
  },
  {
    img: '/images/formaggio.jpg',
    tag_it: 'I pascoli', tag_en: 'The pastures',
    title_it: 'Formaggi', title_en: 'Cheeses',
    text_it: 'La pecora Sopravissana e il gusto delle erbe di montagna custodito nei formaggi.',
    text_en: 'The Sopravissana sheep and the taste of mountain herbs kept in the cheeses.',
  },
];

const edition = await getEdition();
const programme = await getProgramme();
const circuits = await getCircuits();
const preview = programme.slice(0, 3);

// news: la prima è l'apertura, le successive due riempiono la riga (solo desktop)
const articles = await getArticles();
const latestNews = articles[0] || null;
const altreNews = articles.slice(1, 3);

// POI per il modulo laterale del desktop: si stampano tutti e il browser
// ne mostra 3 a caso a ogni visita (così cambiano davvero, non solo a ogni build).
// Parcheggi e piazze servono alla Mappa, non hanno senso tra i "luoghi del gusto".
const NON_GUSTO = ['Parcheggio', 'Luogo evento'];
const places = (await getPlaces()).filter((p) => !NON_GUSTO.includes(p.place_type));

function fmtDate(iso) {
  if (!iso) return '';
  return new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Rome' }).format(new Date(iso));
}

function dateRange(ed) {
  if (!ed?.start_date) return '';
  // Formattazione stabile sul fuso italiano (evita lo scarto di un giorno da UTC).
  const TZ = 'Europe/Rome';
  const day = (d) => new Intl.DateTimeFormat('it-IT', { day: 'numeric', timeZone: TZ }).format(d);
  const monthYear = (d) => new Intl.DateTimeFormat('it-IT', { month: 'long', year: 'numeric', timeZone: TZ }).format(d);
  const s = new Date(ed.start_date);
  const e = ed.end_date ? new Date(ed.end_date) : s;
  return `${day(s)} – ${day(e)} ${monthYear(s)} · Visso`;
}
const range = dateRange(edition);

// L'edizione "Perla dei Sibillini …" è il contenitore di servizio del sito (raccoglie
// gli appuntamenti fuori da un evento vero): non va mostrata col suo nome. Un evento
// vero (es. "Le Guaite del Gusto") sì. Riconosciuto dal titolo che è il nome del sito.
const contenitore = /perla dei sibillini/i.test(edition?.title_it || '');
---
<Base title="La Perla dei Sibillini" description="Visso e i Monti Sibillini: notizie, luoghi del gusto e iniziative del territorio." active="home">
  {/* L'identità del sito non cambia mai: Perla è la piattaforma della community
      di Visso, non il sito di un evento. Gli eventi sono ospiti in evidenza. */}
  <section class="hero">
    <img class="hero-swirl" src="/images/g-swirl.png" alt="" />
    <div class="hero-content">
      <h1 class="hero-wordmark serif">La perla dei Sibillini</h1>
      <p class="hero-sub" data-it="Visso e i Monti Sibillini: notizie, sapori e iniziative del territorio." data-en="Visso and the Sibillini Mountains: news, flavours and local initiatives.">Visso e i Monti Sibillini: notizie, sapori e iniziative del territorio.</p>
    </div>
    <div class="hero-photo-wrap">
      <img class="hero-photo" src="/images/hero.png" alt="Visso" />
    </div>
  </section>

  {/* IN EVIDENZA. L'edizione "Perla dei Sibillini …" è un contenitore di servizio
      (raccoglie gli appuntamenti fuori da un evento vero): NON va mostrata col suo
      nome → invito generico ai prossimi appuntamenti. Un evento vero (es. Le Guaite
      del Gusto) viene invece valorizzato per nome e date. */}
  {edition && (
    <section class="section evidenza con-appuntamenti">
      <div class="evidenza-box">
        {contenitore ? (
          <>
            <div class="evidenza-kicker" data-it="Programma" data-en="Programme">Programma</div>
            <div class="evidenza-title serif" data-it="Prossimi appuntamenti a Visso" data-en="Upcoming events in Visso">Prossimi appuntamenti a Visso</div>
            <p class="evidenza-sub" data-it="Eventi, sagre e iniziative del territorio, giorno per giorno." data-en="Local events, festivals and initiatives, day by day.">Eventi, sagre e iniziative del territorio, giorno per giorno.</p>
            <a href="/programma" class="evidenza-cta" data-it="Scopri i prossimi appuntamenti →" data-en="See what's coming up →">Scopri i prossimi appuntamenti →</a>
          </>
        ) : (
          <>
            <div class="evidenza-kicker" data-it="In evidenza" data-en="Highlight">In evidenza</div>
            <div class="evidenza-title serif">{edition.title_it}</div>
            {range && <div class="evidenza-when">{range}</div>}
            {edition.subtitle_it && (
              <p class="evidenza-sub" data-it={edition.subtitle_it} data-en={edition.subtitle_en}>{edition.subtitle_it}</p>
            )}
            <a href="/programma" class="evidenza-cta" data-it="Scopri il programma →" data-en="See the programme →">Scopri il programma →</a>
          </>
        )}
      </div>
    </section>
  )}

  <nav class="cta-row">
    <a href="/programma" class="cta-btn primary con-appuntamenti" data-it="📅 Programma" data-en="📅 Schedule">📅 Programma</a>
    <a href="/gusto" class="cta-btn" data-it="🍽️ Gusto" data-en="🍽️ Food">🍽️ Gusto</a>
    <a href="/mappa" class="cta-btn" data-it="📍 Mappa" data-en="📍 Map">📍 Mappa</a>
  </nav>

  {/* RAIL — su desktop diventa la colonna di destra: moduli impilati, se uno
      sparisce la colonna si accorcia e il resto non si muove. Su mobile è
      trasparente (i figli scorrono nel flusso come prima). */}
  <div class="rail">
    {preview.length > 0 && (
      <section class="section con-appuntamenti">
        <h2 class="serif"><span data-it="Il programma" data-en="The programme">Il programma</span></h2>
        <p class="section-sub" data-it="Alcuni appuntamenti da vivere" data-en="A few highlights to experience">Alcuni appuntamenti da vivere</p>

        {preview.map((it) => (
          <div class="day-card">
            {it.abstract_it && <div class="day-label" data-it={it.abstract_it} data-en={it.abstract_en}>{it.abstract_it}</div>}
            <div class="day-title serif" data-it={it.title_it} data-en={it.title_en}>{it.title_it}</div>
          </div>
        ))}

        <a href="/programma" class="see-all" data-it="Vedi tutto il programma →" data-en="See full programme →">Vedi tutto il programma →</a>
      </section>
    )}

    {/* MODULO LUOGHI — solo desktop: 3 POI estratti a caso dal browser */}
    {places.length > 0 && (
      <section class="section poi-modulo">
        <h2 class="serif"><span data-it="I luoghi del gusto" data-en="The places of taste">I luoghi del gusto</span></h2>
        <div id="poiPick">
          {places.map((pl) => (
            <div class="poi-voce" hidden>
              <div class="poi-voce-nome serif">{pl.name}</div>
              <div class="poi-voce-meta">{[pl.place_type, pl.city].filter(Boolean).join(' · ')}</div>
              {pl.description_it && (
                <p class="poi-voce-desc" data-it={pl.description_it} data-en={pl.description_en || pl.description_it}>{pl.description_it}</p>
              )}
            </div>
          ))}
        </div>
        <a href="/gusto" class="see-all" data-it="Vedi tutti i luoghi →" data-en="See all the places →">Vedi tutti i luoghi →</a>
      </section>
    )}
  </div>

  <!-- LA TAVOLOZZA — il racconto dei sapori, intro alla sezione gusto -->
  <section class="section tav-home">
    <h2 class="serif"><span data-it="La tavolozza" data-en="The palette">La tavolozza</span></h2>
    <p class="section-sub" data-it="I sapori vissani, tra terra, acqua, pascoli e boschi" data-en="The flavours of Visso, between land, water, pastures and woods">I sapori vissani, tra terra, acqua, pascoli e boschi</p>

    <p class="subsection-intro" data-it="Legumi, miele, tartufo, trota, salumi e formaggi compongono la Tavolozza dei sapori vissani: un percorso di degustazione che racconta Visso attraverso la terra, l'acqua, i pascoli, i boschi e le antiche sapienze produttive della montagna." data-en="Legumes, honey, truffle, trout, cured meats and cheeses make up the Palette of Visso flavours: a tasting journey that tells the story of Visso through its land, water, pastures, woods and the mountain's ancient production wisdom.">Legumi, miele, tartufo, trota, salumi e formaggi compongono la Tavolozza dei sapori vissani: un percorso di degustazione che racconta Visso attraverso la terra, l'acqua, i pascoli, i boschi e le antiche sapienze produttive della montagna.</p>

    <div class="callout" data-it="Domenica pomeriggio la Tavolozza sarà protagonista de «Le Guaite del Gusto, lo spettacolo dei Sibillini». Prenotati su tipicita.it per ricevere la degustazione esclusiva della Tavolozza di Visso." data-en="On Sunday afternoon the Palette takes centre stage at «Le Guaite del Gusto, lo spettacolo dei Sibillini». Book on tipicita.it to receive the exclusive tasting of Visso's Palette.">Domenica pomeriggio la Tavolozza sarà protagonista de «Le Guaite del Gusto, lo spettacolo dei Sibillini». Prenotati su tipicita.it per ricevere la degustazione esclusiva della Tavolozza di Visso.</div>

    <div class="tav-cards">
      {TAVOLOZZA.map((t) => (
        <div class="tav-detail-card">
          <img class="tav-detail-icon" src={t.img} alt={t.title_it} loading="lazy" />
          <div>
            <div class="tav-detail-tag" data-it={t.tag_it} data-en={t.tag_en}>{t.tag_it}</div>
            <div class="tav-detail-title" data-it={t.title_it} data-en={t.title_en}>{t.title_it}</div>
            <div class="tav-detail-text" data-it={t.text_it} data-en={t.text_en}>{t.text_it}</div>
          </div>
        </div>
      ))}
    </div>

    <a class="book-btn ext" href={TAVOLOZZA_BOOKING_URL} target="_blank" rel="noopener">🎟️ <span data-it="Prenota la degustazione su tipicita.it" data-en="Book the tasting on tipicita.it">Prenota la degustazione su tipicita.it</span></a>

    <div class="tavolozza-block" style="margin-top:20px">
      <h3 class="serif" data-it="I circuiti del gusto" data-en="The flavour circuits">I circuiti del gusto</h3>
      <p data-it="Punti del gusto, botteghe, esperienze e proposte speciali dei locali del territorio." data-en="Flavour spots, shops, experiences and special offers from the local venues.">Punti del gusto, botteghe, esperienze e proposte speciali dei locali del territorio.</p>
      <a href="/gusto" class="tav-link" data-it="Scopri il gusto →" data-en="Discover the flavour →">Scopri il gusto →</a>
    </div>
  </section>

  {latestNews && (
    <section class="section news-home">
      <h2 class="serif"><span data-it="Dalle news" data-en="From the news">Dalle news</span></h2>
      <p class="section-sub" data-it="L'ultima notizia dal territorio" data-en="The latest news from the territory">L'ultima notizia dal territorio</p>

      <a class={"news-card" + (latestNews.cover_image ? " has-cover" : "")} href={`/news/${latestNews.slug}`}>
        {latestNews.cover_image && (
          <img class="news-cover" src={assetImg(latestNews.cover_image, 1000)} alt="" loading="lazy" />
        )}
        <div class="news-card-body">
          {latestNews.date_created && (
            <div class="news-card-data">{fmtDate(latestNews.date_created)}</div>
          )}
          <div class="news-card-titolo serif" data-it={latestNews.title_it} data-en={latestNews.title_en || latestNews.title_it}>{latestNews.title_it}</div>
          {latestNews.abstract_it && (
            <p class="news-card-testo" data-it={latestNews.abstract_it} data-en={latestNews.abstract_en || latestNews.abstract_it}>{latestNews.abstract_it}</p>
          )}
          <span class="news-card-leggi" data-it="Leggi →" data-en="Read →">Leggi →</span>
        </div>
      </a>

      {/* Le altre due notizie affiancano l'apertura: compaiono solo su desktop */}
      {altreNews.length > 0 && (
        <div class="news-secondarie">
          {altreNews.map((a) => (
            <a class="news-mini" href={`/news/${a.slug}`}>
              {a.cover_image && (
                <img class="news-mini-cover" src={assetImg(a.cover_image, 600)} alt="" loading="lazy" />
              )}
              {a.date_created && <div class="news-mini-data">{fmtDate(a.date_created)}</div>}
              <div class="news-mini-titolo serif" data-it={a.title_it} data-en={a.title_en || a.title_it}>{a.title_it}</div>
              {a.abstract_it && (
                <p class="news-mini-testo" data-it={a.abstract_it} data-en={a.abstract_en || a.abstract_it}>{a.abstract_it}</p>
              )}
            </a>
          ))}
        </div>
      )}

      <a href="/news" class="see-all" data-it="Vedi tutte le news →" data-en="See all the news →">Vedi tutte le news →</a>
    </section>
  )}

  <script is:inline>
    // Mostra 3 luoghi a caso a ogni visita (sono tutti già nella pagina, nascosti).
    (function () {
      var box = document.getElementById('poiPick');
      if (!box) return;
      var voci = Array.prototype.slice.call(box.querySelectorAll('.poi-voce'));
      for (var i = voci.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = voci[i]; voci[i] = voci[j]; voci[j] = t;
      }
      voci.slice(0, 3).forEach(function (el) { el.hidden = false; });
    })();
  </script>
</Base>
